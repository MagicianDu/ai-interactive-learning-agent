{
  "name": "ai-interactive-learning-agent",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "AI-driven interactive learning experience generator.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --passWithNoTests --pool threads --exclude tools/agent-runtime/learner/real-source-regression.test.ts",
    "test:regression": "vitest run --passWithNoTests --pool threads tools/agent-runtime/learner/real-source-regression.test.ts",
    "test:ci": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run bundle:check",
    "test:watch": "vitest",
    "agent": "tsx tools/agent-runtime/cli.ts",
    "agent:plan": "tsx tools/agent-runtime/cli.ts plan",
    "agent:init-from-plan": "tsx tools/agent-runtime/cli.ts init-from-plan",
    "agent:init": "tsx tools/agent-runtime/cli.ts init",
    "agent:status": "tsx tools/agent-runtime/cli.ts status",
    "agent:beta-status": "tsx tools/agent-runtime/cli.ts beta-status",
    "agent:run": "tsx tools/agent-runtime/cli.ts run",
    "agent:submit": "tsx tools/agent-runtime/cli.ts submit",
    "agent:approve": "tsx tools/agent-runtime/cli.ts approve",
    "agent:revise": "tsx tools/agent-runtime/cli.ts revise",
    "agent:resume": "tsx tools/agent-runtime/cli.ts resume",
    "agent:promote": "tsx tools/agent-runtime/cli.ts promote",
    "agent:units": "tsx tools/agent-runtime/cli.ts units",
    "agent:select-unit": "tsx tools/agent-runtime/cli.ts select-unit",
    "agent:spawn-units": "tsx tools/agent-runtime/cli.ts spawn-units",
    "agent:run-units": "tsx tools/agent-runtime/cli.ts run-units",
    "agent:promote-units": "tsx tools/agent-runtime/cli.ts promote-units",
    "agent:course": "tsx tools/agent-runtime/cli.ts course",
    "mcp": "tsx tools/mcp-server/index.ts",
    "codex:mcp:install": "tsx scripts/install-codex-mcp.ts --install",
    "codex:mcp:check": "tsx scripts/install-codex-mcp.ts --check",
    "codex:skills:install": "tsx scripts/learning-agent-bundle.ts --install-codex-skills",
    "codex:bundle:install": "npm run codex:mcp:install && npm run codex:skills:install",
    "bundle:check": "tsx scripts/learning-agent-bundle.ts --check",
    "source:regression": "tsx tools/agent-runtime/learner/real-source-regression-cli.ts",
    "seed:check": "tsx scripts/beta-seed-check.ts"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
